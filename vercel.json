{
  "version": 2,
  "builds": [
    {
      "src": "bistterminal/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "50mb",
        "includeFiles": "terminal/**"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "bistterminal/wsgi.py"
    }
  ]
}
